# ---------------------------------------------------------------- basics
APP_NAME=DMARCula
DEFAULT_LANGUAGE=en                         # only if the browser sends no language; SK browsers get Slovak, others English
BASE_URL=https://dmarc.example.com          # public URL (used for the SSO redirect URI)
SECRET_KEY=                                 # long random string: openssl rand -base64 48
                                            # also encrypts stored mailbox credentials – changing it means re-entering them
COOKIE_SECURE=true                          # true when served over HTTPS
SESSION_MAX_AGE_HOURS=12

# Database – pick one (default: SQLite in ./data/dmarcula.db)
# DATABASE_URL=mysql+pymysql://dmarcula:PASSWORD@localhost:3306/dmarcula
# DATABASE_URL=postgresql+psycopg://dmarcula:PASSWORD@localhost:5432/dmarcula
# DATABASE_URL=sqlite:///./data/dmarcula.db
POSTGRES_PASSWORD=                          # only used by docker-compose.yml

# First local administrator (created only when the user table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LOCAL_LOGIN_ENABLED=true

# ---------------------------------------------------------------- LDAP / Active Directory
LDAP_ENABLED=false
LDAP_SERVER=ldaps://dc01.example.local:636
LDAP_START_TLS=false
LDAP_TLS_VERIFY=true
LDAP_CA_FILE=
LDAP_BIND_DN=CN=svc-dmarcula,OU=Service,DC=example,DC=local
LDAP_BIND_PASSWORD=
# without a service account: leave LDAP_BIND_DN empty and set the UPN suffix
LDAP_UPN_SUFFIX=example.local
LDAP_BASE_DN=DC=example,DC=local
LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={username})(userPrincipalName={username})))
LDAP_ALLOWED_GROUP=CN=DMARC-Users,OU=Groups,DC=example,DC=local
LDAP_ADMIN_GROUP=CN=DMARC-Admins,OU=Groups,DC=example,DC=local
LDAP_NESTED_GROUPS=true

# ---------------------------------------------------------------- SSO (OpenID Connect)
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_BUTTON_LABEL=Prihlásiť cez Microsoft
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
OIDC_ALLOWED_GROUPS=                        # comma separated group object IDs or app role names
OIDC_ADMIN_GROUPS=
DEFAULT_ROLE=viewer

# ---------------------------------------------------------------- processing
SCHEDULER_ENABLED=true                      # false = poll from cron: python -m app.manage poll
POLL_INTERVAL_MINUTES=15
DNS_REFRESH_HOURS=24
RESOLVE_PTR=true
# Public resolvers: internal (split-horizon / AD) DNS often hides your public SPF, DKIM and DMARC records.
# Leave empty to use the system resolvers.
DNS_SERVERS=1.1.1.1,8.8.8.8
GEOIP_COUNTRY_DB=                           # /path/GeoLite2-Country.mmdb
GEOIP_ASN_DB=                               # /path/GeoLite2-ASN.mmdb
MAX_ATTACHMENT_MB=50
RAW_XML_MAX_KB=2048                         # larger report XML is not stored verbatim (records always are)
