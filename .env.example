# ---------------------------------------------------------------- základ
APP_NAME=DMARCula
BASE_URL=https://dmarc.contoso.sk          # verejná URL (pre SSO redirect)
SECRET_KEY=                                 # dlhý náhodný reťazec: python -c "import secrets;print(secrets.token_urlsafe(48))"
                                            # POZOR: šifrujú sa ním aj uložené heslá schránok – po zmene ich treba zadať znova
COOKIE_SECURE=true                          # true za HTTPS
SESSION_MAX_AGE_HOURS=12
POSTGRES_PASSWORD=                          # heslo DB pre docker compose
# DATABASE_URL=sqlite:///./data/dmarcula.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dmarcula

# Prvý lokálny administrátor (vytvorí sa, iba ak v DB nie je žiadny používateľ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LOCAL_LOGIN_ENABLED=true

# ---------------------------------------------------------------- LDAP / AD
LDAP_ENABLED=false
LDAP_SERVER=ldaps://dc01.contoso.local:636
LDAP_START_TLS=false
LDAP_TLS_VERIFY=true
LDAP_CA_FILE=
LDAP_BIND_DN=CN=svc-dmarcula,OU=Service,DC=contoso,DC=local
LDAP_BIND_PASSWORD=
# bez servisného účtu: nechajte LDAP_BIND_DN prázdne a nastavte UPN suffix
LDAP_UPN_SUFFIX=contoso.local
LDAP_BASE_DN=DC=contoso,DC=local
LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={username})(userPrincipalName={username})))
LDAP_ALLOWED_GROUP=CN=DMARC-Users,OU=Groups,DC=contoso,DC=local
LDAP_ADMIN_GROUP=CN=DMARC-Admins,OU=Groups,DC=contoso,DC=local
LDAP_NESTED_GROUPS=true

# ---------------------------------------------------------------- SSO (OIDC)
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_BUTTON_LABEL=Prihlásiť cez Microsoft
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
OIDC_ALLOWED_GROUPS=                       # object ID skupín alebo názvy app rolí, oddelené čiarkou
OIDC_ADMIN_GROUPS=
DEFAULT_ROLE=viewer

# ---------------------------------------------------------------- spracovanie
POLL_INTERVAL_MINUTES=15
DNS_REFRESH_HOURS=24
RESOLVE_PTR=true
DNS_SERVERS=                                # napr. 1.1.1.1,8.8.8.8 (prázdne = systémové)
GEOIP_COUNTRY_DB=                           # /geoip/GeoLite2-Country.mmdb
GEOIP_ASN_DB=                               # /geoip/GeoLite2-ASN.mmdb
MAX_ATTACHMENT_MB=50
