# UnDMARC maintenance jobs – copy to /etc/cron.d/undmarc (mode 644).
# Placeholders: __USER__ (app user), __DIR__ (app directory), __DB__ (database), __MAILTO__ (alert e-mail, may be empty).
# Fetching reports is NOT here – the application does that itself every 15 minutes.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=__MAILTO__

# 02:30 daily – database backup to /var/backups/undmarc, keep 30 days
30 2 * * *   __USER__  mariadb-dump --defaults-extra-file=__DIR__/.backup.my.cnf --single-transaction --quick __DB__ | gzip > /var/backups/undmarc/undmarc-$(date +\%F).sql.gz && find /var/backups/undmarc -name 'undmarc-*.sql.gz' -mtime +30 -delete

# 03:15 every Sunday – delete reports older than 2 years
15 3 * * 0   __USER__  cd __DIR__ && .venv/bin/python -m app.manage prune --days 730 > /dev/null

# every 30 minutes – sends a mail (MAILTO) only when a mailbox fails or stalls
*/30 * * * * __USER__  cd __DIR__ && .venv/bin/python -m app.manage status --max-age 60 > /tmp/undmarc-status.txt || cat /tmp/undmarc-status.txt
